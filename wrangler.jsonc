{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uniabuja-market",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/payment/callback"
    ]
  },
  "vars": {
    "AUTOMATED_PAYOUTS_ENABLED": "true",
    "PAYOUTS_VERIFY_ONLY": "true",
    "SUPABASE_URL": "https://bkykccypicpnnqcmxmsm.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_RmwbDTWbdYS0gvw_idXp6g_FL_pvNy0",
    "LIVE_PAYOUTS_ENABLED": "false",
    "PAYSTACK_VENDOR_PLAN_CODE": "PLN_rn6esrf2i9am9n4",
    "APP_URL": "https://uniabujamarket.com.ng"
  },
  "routes": [
    {
      "pattern": "uniabujamarket.com.ng",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}